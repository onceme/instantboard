# HTTP server (full — serves frontend/API directly; used when ENABLE_HTTPS=false)
server {
    listen ${HTTP_PORT};
    server_name ${SERVER_NAME};

    # --- API proxy ---
    # L1 rate limit (zone defined in nginx.conf): 30 r/s per IP, burst of 60
    # of which the first 20 pass immediately and the rest are queued (delay).
    # Longer-prefix locations below override/exempt this: /api/v1/auth/ and
    # /api/v1/stream/ carry their own limit_req, /api/v1/health stays
    # exempt for CD smoke tests. 429 responses inherit the server-level
    # `always` security headers below (this location defines no add_header
    # of its own).
    location /api/ {
        limit_req zone=rl_api burst=60 delay=20;
        proxy_pass http://api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;

        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 60s;
    }

    # --- Auth endpoints ---
    # Longest-prefix match wins over /api/. X-Forwarded-For is OVERWRITTEN (not
    # appended) with the direct peer address: login rate limiting and lockout in the
    # backend are keyed on this header, so it must contain only nginx-observed data.
    # A client-supplied X-Forwarded-For chain is discarded here.
    location /api/v1/auth/ {
        # Strictest zone (5 r/s per IP) — the credential entry point. Coarse
        # edge defense against credential stuffing; the app layer additionally
        # enforces a 10/min sliding-window limit and per email+IP lockout.
        # burst=10 with delay=5: small legitimate bursts (login+refresh, SSO
        # callback fan-out) pass, sustained floods queue then 429.
        limit_req zone=rl_auth burst=10 delay=5;
        proxy_pass http://api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;

        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 60s;
    }

    # --- SSE stream ---
    # The frontend requests /api/v1/stream/<category> (frontend/src/utils/sse.ts), so the
    # SSE-tuned location must match that prefix; a bare /stream/ block is never hit and
    # requests fall through to the buffered /api/ location, breaking the event stream.
    location /api/v1/stream/ {
        # Limits only the SSE CONNECTION-ESTABLISHMENT rate (2 r/s per IP).
        # limit_req evaluates a request once, at entry — an established SSE
        # long connection streams for hours (proxy_read_timeout 86400s) without
        # consuming further budget, so steady-state streams are untouched.
        # burst=8 nodelay: absorbs reconnect storms after network jitter /
        # tab wakes without queueing (queued handshakes would stall the
        # event stream anyway).
        limit_req zone=rl_sse burst=8 nodelay;
        proxy_pass http://api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;

        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_set_header X-Accel-Buffering no;

        add_header Access-Control-Allow-Origin $http_origin always;
        add_header Access-Control-Allow-Credentials true always;
        add_header Access-Control-Allow-Headers "Authorization" always;
    }

    # --- Health check ---
    location /api/v1/health {
        proxy_pass http://api;
        proxy_set_header Host $host;
        access_log off;
    }

    # Dedicated nginx health-check endpoint for the container healthcheck
    # (docker-compose.prod.yml). Mirrors the /healthz location of the
    # http-redirect template so the probe command works identically in both
    # ENABLE_HTTPS modes.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok";
    }

    # --- Frontend static files ---
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # --- Static assets caching ---
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        root /usr/share/nginx/html;
        expires 7d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # --- Security headers ---
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    # Content-Security-Policy — hard-coded constant, deliberately NOT an
    # envsubst variable (keeps entrypoint.sh's whitelist unchanged; see
    # docs/dev-guide/design/security.md §3.2). Deviations from the documented
    # target policy, by design:
    #   - img-src additionally allows `data:` (news thumbnails / inline images);
    #   - base-uri / frame-ancestors / object-src are defense-in-depth on top of
    #     the target policy (frame-ancestors 'none' supersedes X-Frame-Options
    #     in modern browsers).
    # Compatible with the app: SPA scripts/styles are self-hosted (build output
    # contains no inline scripts), API and EventSource SSE are same-origin
    # (covered by connect-src 'self'), no third-party scripts/fonts/styles.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'" always;
}
