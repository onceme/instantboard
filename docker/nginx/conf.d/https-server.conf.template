# HTTPS server (used only when ENABLE_HTTPS=true)
server {
    listen ${HTTPS_PORT} ssl http2;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;

    # Mozilla Modern configuration
    ssl_protocols TLSv1.3;
    ssl_prefer_server_ciphers off;

    # HSTS — max-age is configurable via HSTS_MAX_AGE (default applied by
    # entrypoint.sh: 31536000 = 1 year). DO NOT add `preload`: the site is
    # served on a non-standard public port and preload lists are keyed by host
    # name only — a preload entry would force HTTPS for this domain on ALL
    # ports forever, poisoning any future use of the domain on other ports.
    # Keep max-age moderate for staging/transitional deployments; consider a
    # longer max-age only after production HTTPS has proven stable.
    add_header Strict-Transport-Security "max-age=${HSTS_MAX_AGE}; includeSubDomains" always;

    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # --- API proxy ---
    location /api/ {
        proxy_pass http://api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    # --- Auth endpoints ---
    # Longest-prefix match wins over /api/. X-Forwarded-For is OVERWRITTEN (not
    # appended) with the direct peer address: login rate limiting and lockout in the
    # backend are keyed on this header, so it must contain only nginx-observed data.
    # A client-supplied X-Forwarded-For chain is discarded here.
    location /api/v1/auth/ {
        proxy_pass http://api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    # --- SSE stream ---
    # The frontend requests /api/v1/stream/<category> (frontend/src/utils/sse.ts), so the
    # SSE-tuned location must match that prefix; a bare /stream/ block is never hit and
    # requests fall through to the buffered /api/ location, breaking the event stream.
    location /api/v1/stream/ {
        proxy_pass http://api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;

        proxy_set_header Connection '';
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_set_header X-Accel-Buffering no;

        add_header Access-Control-Allow-Origin $http_origin always;
        add_header Access-Control-Allow-Credentials true always;
    }

    # --- Frontend static files ---
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # --- Static assets caching ---
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        root /usr/share/nginx/html;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # --- Security headers ---
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    # Content-Security-Policy — hard-coded constant, deliberately NOT an
    # envsubst variable (keeps entrypoint.sh's whitelist unchanged; see
    # docs/dev-guide/design/security.md §3.2). Deviations from the documented
    # target policy, by design:
    #   - img-src additionally allows `data:` (news thumbnails / inline images);
    #   - base-uri / frame-ancestors / object-src are defense-in-depth on top of
    #     the target policy (frame-ancestors 'none' supersedes X-Frame-Options
    #     in modern browsers).
    # Compatible with the app: SPA scripts/styles are self-hosted (build output
    # contains no inline scripts), API and EventSource SSE are same-origin
    # (covered by connect-src 'self'), no third-party scripts/fonts/styles.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'" always;
}
