# ============================================
# InstantBoard environment variable template
# Copy this file to .env and fill in the actual values
# This file is committed to Git and contains no secrets
# ============================================

# --- General ---
ENV=development
LOG_LEVEL=INFO
APP_ENV=development

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://instantboard:devpass@localhost:5432/instantboard_dev
DB_PASSWORD=devpass
POSTGRES_USER=instantboard
POSTGRES_DB=instantboard_dev
POSTGRES_PORT=5432
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_MAX_MEMORY=512mb

# --- MongoDB (not enabled in the initial version) ---
MONGODB_URL=mongodb://instantboard:devpass@localhost:27017/instantboard_dev
MONGO_USER=instantboard
MONGO_PASSWORD=devpass
MONGODB_PORT=27017

# --- JWT / Authentication ---
SECRET_KEY=change-this-in-production-use-a-strong-random-key
JWT_SECRET=change-this-in-production-use-a-strong-random-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- SSO OAuth Credentials (apply for these yourself) ---
# Enabled SSO providers (comma-separated, default: google,github)
# Allowed values: google, github, azure_ad, apple, facebook
ENABLED_SSO_PROVIDERS=google,github

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Local Admin Login (optional; see docs/design/admin-login.md) ---
# Enables the isolated "local" admin identity used by POST /api/v1/auth/admin/login.
# Admin login is active only when BOTH admin_email and admin_password_hash are set.
# The admin account lives in the system tenant with provider='local' and is never
# merged with SSO users, even when the email matches.
#
# ADMIN_EMAIL: the email allowed to authenticate as the local admin.
ADMIN_EMAIL=
#
# ADMIN_PASSWORD_HASH: bcrypt hash of the admin password. NEVER store plaintext here.
# Generate it with either:
#   make gen-admin-hash PASS='YourSecret'
#   python scripts/gen_admin_password_hash.py     (prompts securely on stdin)
# then paste the printed "$2b$..." string below.
ADMIN_PASSWORD_HASH=
#
# ADMIN_PASSWORD (NON-PRODUCTION ONLY): plaintext convenience for dev/test. When ENV is
# not "production", it is bcrypt-hashed once at startup and the plaintext is dropped.
# When ENV=production this value is IGNORED and logged as an error; production must set
# ADMIN_PASSWORD_HASH above. Leave empty unless you are in a non-production environment.
ADMIN_PASSWORD=

# --- Financial Data API Keys ---
YAHOO_FINANCE_API_KEY=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
FINNHUB_API_KEYS=[]

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- SSE ---
SSE_HEARTBEAT_INTERVAL=30

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# --- Tenant Defaults ---
DEFAULT_TENANT_SLUG=default
DEFAULT_TENANT_NAME=Default Tenant

# --- Scheduler ---
SCHEDULER_ENABLED=true

# --- API Server ---
API_PORT=8000
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_WORKERS=1

# --- Frontend ---
# FRONTEND_PORT: Host port that exposes the frontend static files container
#                (container always listens on port 80 inside)
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000
VITE_SSE_URL=http://localhost:8000

# --- Nginx / SSL ---
# SERVER_NAME: nginx server_name directive. "_" = catch-all (good for local/dev);
#              in production, use a real domain like "ib.bithollow.org"
# HTTP_PORT / HTTPS_PORT: Host ports exposed to clients; nginx container listens on the same ports
# ENABLE_HTTPS: Set "true" only when SSL_CERT_DIR contains valid fullchain.pem + privkey.pem
# SSL_CERT_DIR: Host path to directory containing SSL certificates
SERVER_NAME=_
HTTP_PORT=80
HTTPS_PORT=443
ENABLE_HTTPS=false
SSL_CERT_DIR=./nginx/ssl

# --- TLS / Outbound HTTPS ---
# CA bundle used for Python outbound HTTPS verification. Python's default bundle
# (certifi, Mozilla-based) has removed some legacy root certificates (e.g. Baltimore,
# AAA, old GlobalSign, old DigiCert) that many real-world sites still chain to, which
# breaks TLS verification. Point at the OS trust store instead.
# NOTE: the Docker images already set this ENV in the Dockerfile, so this entry is only
# needed for non-Docker runs (local venv, etc.). On non-Debian systems adjust the path
# to the system CA bundle. Do NOT add REQUESTS_CA_BUNDLE/CURL_CA_BUNDLE: the backend
# does not use requests/curl for HTTPS.
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# ============================================
# Extra variables for production
# Local development uses the defaults below; override them via GitHub Secrets or .env in real deployments
# ============================================
PROD_DATABASE_URL=postgresql+asyncpg://instantboard:prodpass123@postgres:5432/instantboard
PROD_REDIS_URL=redis://:prodredis123@redis:6379/0
PROD_SECRET_KEY=change-this-prod-secret-key-at-least-32-chars
PROD_JWT_SECRET=change-this-prod-jwt-secret-at-least-32-chars
PROD_DB_PASSWORD=prodpass123
PROD_REDIS_PASSWORD=prodredis123
PROD_POSTGRES_DB=instantboard
PROD_POSTGRES_USER=instantboard
PROD_MONGO_USER=instantboard
PROD_MONGO_PASSWORD=prodmongo123
PROD_DOMAIN=your-production-domain.com
PROD_CORS_ORIGINS=https://your-production-domain.com
