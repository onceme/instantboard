# ============================================
# InstantBoard 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# 此文件入 Git，不含敏感值
# ============================================

# --- 通用 ---
ENV=development
LOG_LEVEL=INFO
APP_ENV=development

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://instantboard:devpass@localhost:5432/instantboard_dev
DB_PASSWORD=devpass
POSTGRES_USER=instantboard
POSTGRES_DB=instantboard_dev
POSTGRES_PORT=5432
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_MAX_MEMORY=512mb

# --- MongoDB (初始版本不启用) ---
MONGODB_URL=mongodb://instantboard:devpass@localhost:27017/instantboard_dev
MONGO_USER=instantboard
MONGO_PASSWORD=devpass
MONGODB_PORT=27017

# --- JWT / 认证 ---
SECRET_KEY=change-this-in-production-use-a-strong-random-key
JWT_SECRET=change-this-in-production-use-a-strong-random-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- SSO OAuth Credentials (需要用户自行申请) ---
# SSO 启用的提供商（逗号分隔，默认: google,github）
# 可选值: google, github, azure_ad, apple, facebook
ENABLED_SSO_PROVIDERS=google,github

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Financial Data API Keys ---
YAHOO_FINANCE_API_KEY=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
FINNHUB_API_KEYS=[]

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- SSE ---
SSE_HEARTBEAT_INTERVAL=30

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# --- Tenant Defaults ---
DEFAULT_TENANT_SLUG=default
DEFAULT_TENANT_NAME=Default Tenant

# --- Scheduler ---
SCHEDULER_ENABLED=true

# --- API Server ---
API_PORT=8000
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_WORKERS=1

# --- Frontend ---
# FRONTEND_PORT: Host port that exposes the frontend static files container
#                (container always listens on port 80 inside)
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000
VITE_SSE_URL=http://localhost:8000

# --- Nginx / SSL ---
# SERVER_NAME: nginx server_name directive. "_" = catch-all (good for local/dev);
#              in production, use a real domain like "ib.bithollow.org"
# HTTP_PORT / HTTPS_PORT: Host ports exposed to clients; nginx container listens on the same ports
# ENABLE_HTTPS: Set "true" only when SSL_CERT_DIR contains valid fullchain.pem + privkey.pem
# SSL_CERT_DIR: Host path to directory containing SSL certificates
SERVER_NAME=_
HTTP_PORT=80
HTTPS_PORT=443
ENABLE_HTTPS=false
SSL_CERT_DIR=./nginx/ssl

# ============================================
# 生产环境额外变量
# 本地开发使用以下默认值，实际部署时通过 GitHub Secrets 或 .env 覆盖
# ============================================
PROD_DATABASE_URL=postgresql+asyncpg://instantboard:prodpass123@postgres:5432/instantboard
PROD_REDIS_URL=redis://:prodredis123@redis:6379/0
PROD_SECRET_KEY=change-this-prod-secret-key-at-least-32-chars
PROD_JWT_SECRET=change-this-prod-jwt-secret-at-least-32-chars
PROD_DB_PASSWORD=prodpass123
PROD_REDIS_PASSWORD=prodredis123
PROD_POSTGRES_DB=instantboard
PROD_POSTGRES_USER=instantboard
PROD_MONGO_USER=instantboard
PROD_MONGO_PASSWORD=prodmongo123
PROD_DOMAIN=your-production-domain.com
PROD_CORS_ORIGINS=https://your-production-domain.com
